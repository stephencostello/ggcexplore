# The repo's working tree IS the live document root on this host, so the
# .git directory sits inside the public webroot. Make sure it (and any other
# dot-file/dot-dir like .gitignore) can never be served.
RedirectMatch 404 ^/\.git($|/)

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
